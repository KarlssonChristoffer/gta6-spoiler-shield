{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Shield",
  "version": "1.0.0",
  "description": "Hides posts, videos, comments and whole pages that mention GTA 6, on every site.",
  "homepage_url": "https://github.com/KarlssonChristoffer/gta6-spoiler-shield",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/keywords.js",
        "src/sites.js",
        "src/matcher.js",
        "src/settings.js",
        "src/page-cover.js",
        "src/shield.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "GTA 6 Spoiler Shield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gta6-spoiler-shield@local",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
